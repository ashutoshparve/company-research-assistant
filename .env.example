# --- Required ---

# Serper.dev API key (https://serper.dev) - used for web search
SERPER_API_KEY=your_serper_api_key_here

# OpenRouter API key (https://openrouter.ai) - used for AI analysis
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default AI model to use if the user doesn't pick one in the UI
# Any OpenRouter model slug works, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet
DEFAULT_AI_MODEL=openai/gpt-4o-mini

# Base URL of your deployment, used in OpenRouter's required headers
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Optional (Bonus: Discord Integration) ---
# These can also be entered at runtime in the app's Discord settings panel.
# Set them here only if you want server-side defaults.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
